{
  "expo": {
    "name": "Cycle Tracker",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E8748A"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSHealthShareUsageDescription": "Cycle Tracker reads your basal body temperature from Apple Health to automatically log it each morning and improve your fertility predictions.",
        "NSHealthUpdateUsageDescription": "Cycle Tracker writes basal body temperature readings you log here back to Apple Health so all your health data stays in one place."
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      }
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/icon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Cycle Tracker",
      "shortName": "Cycle",
      "themeColor": "#E8748A",
      "backgroundColor": "#ffffff",
      "description": "Personal cycle and ovulation tracker"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
